{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ahplex:host-config:v1",
  "title": "ahplex static host configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "instance", "dataDir", "listen", "hosts"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "instance": {
      "$ref": "#/$defs/id"
    },
    "dataDir": {
      "type": "string",
      "minLength": 1,
      "description": "Service-instance runtime-data root. The core derives hosts/<hostId> directories beneath it; not an agent working directory or a guarantee of durable execution storage."
    },
    "listen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port"],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      }
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "module", "options"],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "module": {
            "type": "string",
            "minLength": 1,
            "description": "Explicit local ESM .js/.mjs path. Semantic validation rejects URLs and package specifiers."
          },
          "options": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "hosts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/host"
      }
    }
  },
  "$defs": {
    "ahpdOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port",
        "plugin",
        "copilotCommand",
        "copilotProfileDir",
        "trustedDirectories",
        "runtimeRevision"
      ],
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "plugin": { "type": "string", "minLength": 1 },
        "copilotCommand": { "type": "string", "minLength": 1 },
        "copilotProfileDir": { "type": "string", "minLength": 1 },
        "loginAccount": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
        },
        "trustedDirectories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "format": "uri", "pattern": "^file:/" }
        },
        "runtimeRevision": {
          "const": "8c6f4645b90a05d47e43359565cb5697b011a43d",
          "description": "Required operator-verified patched 0.15.0-rc.1 runtime provenance; not a binary checksum."
        }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "secret": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "name"],
          "properties": {
            "source": {
              "const": "env"
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "path"],
          "properties": {
            "source": {
              "const": "file"
            },
            "path": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "startup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "args", "env"],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/secret"
              }
            ]
          }
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "provider", "resource", "adapter", "options"],
      "allOf": [
        {
          "if": { "properties": { "adapter": { "const": "copilot-cli" } } },
          "then": {
            "properties": {
              "provider": { "const": "copilot" },
              "resource": { "const": "https://api.github.com/repos" },
              "options": {
                "type": "object",
                "additionalProperties": false,
                "required": ["mode"],
                "properties": { "mode": { "enum": ["login", "reuse"] } }
              }
            }
          }
        }
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "resource": {
          "type": "string",
          "format": "uri"
        },
        "adapter": {
          "$ref": "#/$defs/id"
        },
        "options": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "adapter",
        "startup",
        "lifecycle",
        "options",
        "authentication"
      ],
      "allOf": [
        {
          "if": { "properties": { "adapter": { "const": "ahpd" } } },
          "then": {
            "properties": { "options": { "$ref": "#/$defs/ahpdOptions" } }
          }
        }
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "adapter": {
          "$ref": "#/$defs/id"
        },
        "startup": {
          "$ref": "#/$defs/startup"
        },
        "lifecycle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["prepareOnStartup", "onDemand", "startupTimeoutMs"],
          "properties": {
            "prepareOnStartup": {
              "type": "boolean"
            },
            "onDemand": {
              "type": "boolean"
            },
            "startupTimeoutMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          }
        },
        "options": {
          "type": "object",
          "additionalProperties": true
        },
        "authentication": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/authentication"
          }
        }
      }
    }
  }
}
