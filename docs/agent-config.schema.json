{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "instance": {
      "type": "string",
      "minLength": 1,
      "default": "local"
    },
    "dataDir": {
      "type": "string",
      "minLength": 1
    },
    "listen": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1,
          "default": "127.0.0.1"
        },
        "port": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "default": 4280
        }
      },
      "required": [],
      "default": {
        "host": "127.0.0.1",
        "port": 4280
      }
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "label": {
            "type": "string",
            "default": ""
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": ["--acp"]
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "source": {
                      "const": "env"
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": ["source", "name"]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "source": {
                      "const": "file"
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": ["source", "path"]
                }
              ]
            },
            "default": {}
          },
          "profileDir": {
            "type": "string",
            "minLength": 1
          },
          "mcpServers": {
            "type": "array",
            "default": [],
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "command": {
                      "type": "string",
                      "minLength": 1
                    },
                    "args": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "env": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "name": {
                            "type": "string",
                            "minLength": 1
                          },
                          "value": {
                            "type": "string"
                          }
                        },
                        "required": ["name", "value"]
                      }
                    }
                  },
                  "required": ["name", "command", "args", "env"]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "enum": ["http", "sse"]
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "url": {
                      "type": "string",
                      "minLength": 1
                    },
                    "headers": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "name": {
                            "type": "string",
                            "minLength": 1
                          },
                          "value": {
                            "type": "string"
                          }
                        },
                        "required": ["name", "value"]
                      }
                    }
                  },
                  "required": ["type", "name", "url", "headers"]
                }
              ]
            }
          },
          "startupTimeoutMs": {
            "type": "integer",
            "minimum": 100,
            "maximum": 300000,
            "default": 30000
          },
          "idleTimeoutMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 86400000,
            "default": 0
          },
          "permission": {
            "enum": ["deny", "allow"],
            "default": "deny"
          },
          "authentication": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "copilot"
              },
              "loginAccount": {
                "type": "string",
                "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
              }
            },
            "required": ["type", "loginAccount"]
          }
        },
        "required": ["id", "command", "profileDir"]
      }
    }
  },
  "required": ["schemaVersion", "dataDir", "agents"]
}
