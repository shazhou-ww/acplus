{
  "$schema": "./host-config.schema.json",
  "schemaVersion": 1,
  "instance": "ahpd-experiment",
  "dataDir": "/var/lib/ahplex/ahpd-candidate",
  "listen": { "host": "127.0.0.1", "port": 4291 },
  "hosts": [
    {
      "id": "ahpd",
      "label": "Pinned experimental AHPD / Copilot",
      "adapter": "ahpd",
      "startup": {
        "command": "/usr/bin/node",
        "args": [
          "/opt/ahplex/ahpd-fixed/node_modules/@ahpd/server/dist/main.js"
        ],
        "env": {},
        "cwd": "/srv/ahplex/workspace"
      },
      "lifecycle": {
        "prepareOnStartup": false,
        "onDemand": true,
        "startupTimeoutMs": 60000
      },
      "options": {
        "port": 19491,
        "plugin": "/opt/ahplex/ahpd-fixed/node_modules/@ahpd/agent-acp",
        "copilotCommand": "/opt/ahplex/copilot/node_modules/.bin/copilot",
        "copilotProfileDir": "/var/lib/ahplex/copilot-profile",
        "loginAccount": "operator-login",
        "trustedDirectories": ["file:///srv/ahplex/workspace"],
        "runtimeRevision": "1d52d06c65ec1006d548bad7c477e032b9dc6782"
      },
      "authentication": [
        {
          "id": "native-login",
          "provider": "copilot",
          "resource": "https://api.github.com/repos",
          "adapter": "copilot-cli",
          "options": { "mode": "login" }
        },
        {
          "id": "reuse-native-login",
          "provider": "copilot",
          "resource": "https://api.github.com/repos",
          "adapter": "copilot-cli",
          "options": { "mode": "reuse" }
        }
      ]
    }
  ]
}
